{
  "role": {
    "$description": "Semantic roles, dark theme. role.light.json and role.dark.json are two sets of the same names; the build pairs them into light-dark().",
    "background": {
      "$type": "color",
      "$value": "{palette.dark.paper}"
    },
    "foreground": {
      "$type": "color",
      "$value": "{palette.dark.ink}"
    },
    "mark": {
      "$type": "color",
      "$value": "{palette.dark.ink}",
      "$description": "The doll's colour on Forspring's own pages: ink, paper on dark (hub D-101). A product's [data-product] sets its accent here instead. Not a shadcn role."
    },
    "body-foreground": {
      "$type": "color",
      "$value": "{palette.dark.body}",
      "$description": "Running text, a step softer than foreground (headings, strong). Not a shadcn role."
    },
    "card": {
      "$type": "color",
      "$value": "{palette.dark.card}"
    },
    "card-foreground": {
      "$type": "color",
      "$value": "{palette.dark.ink}"
    },
    "popover": {
      "$type": "color",
      "$value": "{palette.dark.card}",
      "$description": "shadcn alias."
    },
    "popover-foreground": {
      "$type": "color",
      "$value": "{palette.dark.ink}",
      "$description": "shadcn alias."
    },
    "muted": {
      "$type": "color",
      "$value": "{palette.dark.soft}"
    },
    "muted-foreground": {
      "$type": "color",
      "$value": "{palette.dark.muted}"
    },
    "secondary": {
      "$type": "color",
      "$value": "{palette.dark.soft}",
      "$description": "shadcn alias."
    },
    "secondary-foreground": {
      "$type": "color",
      "$value": "{palette.dark.ink}",
      "$description": "shadcn alias."
    },
    "accent": {
      "$type": "color",
      "$value": "{palette.dark.soft}",
      "$description": "shadcn's accent is a hover surface, not the product accent. The product accent is primary."
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{palette.dark.ink}",
      "$description": "shadcn alias."
    },
    "border": {
      "$type": "color",
      "$value": "{palette.dark.line}"
    },
    "input": {
      "$type": "color",
      "$value": "{palette.dark.line-strong}"
    },
    "primary": {
      "$type": "color",
      "$value": "{accent.forspring.dark}",
      "$description": "The product accent. [data-product] swaps it; forspring is the default."
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "{palette.dark.paper}",
      "$description": "Text on primary. White on the light accents; the dark ground on the lifted dark accents, where white is under 4.5:1."
    },
    "ring": {
      "$type": "color",
      "$value": "{accent.forspring.dark}",
      "$description": "Focus ring: follows primary."
    },
    "success": {
      "$type": "color",
      "$value": "{status.success.dark}"
    },
    "warning": {
      "$type": "color",
      "$value": "{status.warning.dark}"
    },
    "danger": {
      "$type": "color",
      "$value": "{status.danger.dark}"
    },
    "destructive": {
      "$type": "color",
