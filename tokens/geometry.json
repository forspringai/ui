  "control": {
    "$description": "Control heights (D-14): inputs, selects and buttons share one height per size, so a row of them lines up on one baseline. Each is a step of the space scale.",
    "height": {
      "$type": "dimension",
      "$value": "{space.11}",
      "$description": "Inputs, selects, buttons: 1px border, 12px padding, an 18px line (15px type at 1.2)."
    },
    "height-small": {
      "$type": "dimension",
      "$value": "{space.8}",
      "$description": "Small buttons, small inputs and selects, and every control in the bar."
    },
    "touch": {
      "$type": "dimension",
      "$value": "{space.11}",
      "$description": "The floor for primary controls under 560px, where fingers are used (WCAG 2.5.5 at 44px)."
    }
