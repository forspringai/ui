{
  "name": "@forspring/ui",
  "version": "0.1.0",
  "description": "Forspring suite UI: design tokens built to CSS, a Tailwind v4 theme and TypeScript (hub D-90)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens/*.json": "./tokens/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
