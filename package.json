{
  "name": "@forspring/ui",
  "version": "0.2.0",
  "description": "Forspring suite UI: design tokens, fonts and a server-rendered component layer (hub D-90)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "tokens",
    "fonts",
    "css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./components.css": "./dist/components.css",
    "./google-button.css": "./dist/google-button.css",
    "./fonts/*": "./fonts/*",
    "./tokens/*.json": "./tokens/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
