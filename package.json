{
  "name": "@forspring/ui",
  "version": "0.19.0",
  "description": "Forspring suite UI: design tokens, fonts, brand files, a server-rendered component layer and the design audit (hub D-90, D-101)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "ui-audit": "./dist/audit/cli.js"
  },
  "files": [
    "dist",
    "tokens",
    "fonts",
    "css",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "default": "./dist/connect.js"
    },
    "./refusals": {
      "types": "./dist/refusals.d.ts",
      "default": "./dist/refusals.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./schema/customer-theme.schema.json": "./schema/customer-theme.schema.json",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./components.css": "./dist/components.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./google-button.css": "./dist/google-button.css",
    "./fonts/*": "./fonts/*",
    "./brand/*": "./dist/brand/*",
    "./tokens/*.json": "./tokens/*.json",
    "./audit": {
      "types": "./dist/audit/audit.d.ts",
      "default": "./dist/audit/audit.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node scripts/demo.ts",
    "audit": "node dist/audit/cli.js",
    "test:ci": "vitest run --exclude test/audit.test.ts --exclude test/visual.test.ts",
    "test:browser": "vitest run test/audit.test.ts test/visual.test.ts",
    "test:visual:update": "UPDATE_VISUAL=1 vitest run test/visual.test.ts",
    "ci:log": "doppler run --project forspring --config prd_deploy -- node scripts/ci-log.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "axe-core": "4.14.0"
  },
  "peerDependencies": {
    "playwright": ">=1.50",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
